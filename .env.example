# Local mode requires no API token and is restricted to loopback clients.
VISION_AUTH_MODE=local
VISION_ALLOWED_HOSTS=localhost,127.0.0.1
VISION_DATABASE_URL=sqlite:///data/visionguard.db
VISION_DATA_DIR=data/workspace
VISION_MODEL_DIR=artifacts/surface-v1
# Public hosting requires OIDC + TLS + your real hostname:
# VISION_AUTH_MODE=oidc
# VISION_OIDC_ISSUER=https://identity.example.com/
# VISION_OIDC_AUDIENCE=visionguard
# VISION_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# VISION_ALLOWED_HOSTS=quality.example.com
# VISION_DATABASE_URL=postgresql+psycopg://visionguard:private-password@postgres:5432/visionguard
# Compose requires a fresh random secret:
# VISION_POSTGRES_PASSWORD=replace-with-random-secret
